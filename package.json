{
  "name": "serverless-chaos-demo-nodejs",
  "version": "2.0.0",
  "description": "Serverless chaos engineering demo using failure-lambda v1.0.0",
  "type": "module",
  "scripts": {
    "build": "sam build",
    "deploy": "sam deploy --guided",
    "seed": "./scripts/seed.sh",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test src/wrapper/index.test.mjs src/middy/index.test.mjs",
    "test:python": "python3 -m unittest discover -s src/layer -p 'test_*.py' -v"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@middy/core": "^5.5.0",
    "failure-lambda": "^1.0.0"
  },
  "author": "Gunnar Grosch",
  "license": "MIT"
}
